<div class="row">
  <%= render partial: "shared/breadcrumb" %>
</div>
<div class="row">
  <article class="card col-6 offset-3">
    <header>
      <h3>Deal Notifier</h3>
      <p></p>
      <p class="text-light">At a Glance</p>
    </header>
    <p class="mt-4">Get notified of local game day promotions you can use to save some cash.</p>
  </article>
</div>
<div class="row">
  <article class="card col-6 mt-4 offset-3">
    <header>
      <h3>Sounds Good</h3>
      <p class="text-light">Register below</p>
    </header>
    <%= form_with(url: '/registration', method: :post, model: @user) do |form| %>
      <div class="mt-4">
        <%= form.fields_for :contact_methods do |builder| %>
          <label data-field>
            <%= builder.email_field :contact_detail, required: true, placeholder: 'email' %>
          </label>
        <% end %>

        <label data-field>
          <%= form.text_field :postal, required: true, class: "mb-4 col-span-2", value: session.dig(:geocode_data, 'postal'), autocomplete: "off", placeholder: 'zipcode' %>
        </label>
      </div>

      <footer class="hstack justify-end mt-4">
        <%= form.submit "Register" %>
      </footer>
    <% end %>
    <% if flash[:notice] %>
      <script>
        ot.toast(
          '<%= flash['notice']['message'] %>',
          '<%= flash['notice']['successful'] ? 'Success!' : 'Whoops!' %>',
          { variant: '<%= flash['notice']['successful'] ? 'success' : 'danger' %>', placement: 'top-center' }
        )
      </script>
    <% end %>
  </article>
</div>
<div class="row mb-4">
  <article class="card col-6 mt-4 offset-3">
    <header>
      <h3>View Deals</h3>
      <p class="text-light">Manually check here</p>
    </header>
    <%= form_with(url: '/registration_redirect', method: :post, model: User.new) do |form| %>
      <div class="mt-4">
        <label data-field>
          <%= form.text_field :postal, required: true, class: "mb-4 col-span-2", value: session.dig(:geocode_data, 'postal'), autocomplete: "off", placeholder: 'zipcode' %>
        </label>
      </div>

      <footer class="hstack justify-end mt-4">
        <%= form.submit "Check" %>
      </footer>
    <% end %>
  </article>
</div>
<%= render partial: "shared/footer" %>
