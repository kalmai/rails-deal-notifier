<div class="row">
  <%= render partial: "shared/breadcrumb" %>
</div>
<div class="row mb-4">
  <article class="card col-6 mt-4 offset-3">
    <header>
      <h3>View Deals</h3>
      <p class="text-light">Manually check here</p>
    </header>
    <%= form_with(url: '/registration_redirect', method: :post, model: User.new) do |form| %>
      <div class="mt-4">
        <label data-field>
          <%= form.text_field :postal, required: true, class: "mb-4 col-span-2", value: session.dig(:geocode_data, 'postal'), autocomplete: "off", placeholder: 'zipcode' %>
        </label>
      </div>

      <footer class="hstack justify-end mt-4">
        <%= form.submit "Check" %>
      </footer>
    <% end %>
  </article>
</div>
<div class="row mb-4">
  <article class="card col-6 mt-4 offset-3">
    <header>
      <h3>Deals Right Now</h3>
    </header>
    <div class="table">
      <table>
        <thead>
          <tr>
            <th></th>
            <th>Company</th>
            <th>Code</th>
            <th>More</th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "promotions/promotion", collection: @promotions %>
        </tbody>
      </table>
    </div>
  </article>
</div>
<%= render partial: "shared/footer" %>
