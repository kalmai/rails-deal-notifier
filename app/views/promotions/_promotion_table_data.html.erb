<% @evaluation = promotion.evaluate_most_recent_game ? simple_format("✓", style:"color: green;") : simple_format("✕", style:"color: red;") %>
<td><%= @evaluation %></td>
<td><%= promotion.company %></td>
<td><%= promotion.promo_code || '-' %></td>
<td>
  <button commandfor="demo-dialog" command="show-modal" class="ghost">☰</button>
  <dialog id="demo-dialog" closedby="any">
    <form method="dialog">
      <header>
        <h3 style="display: flex; justify-content: space-between; line-height: inherit;">
          <%= promotion.company %><button type="button" commandfor="demo-dialog" command="close" class="ghost">✕</button>
        </h3>
      </header>
      <div class="table" style="padding-top: 0px; padding-bottom: 0px;">
        <table>
          <tbody>
            <tr>
              <td>Available</td>
              <td><%= @evaluation %></td>
            </tr>
            <tr>
              <td>Name</td>
              <td><%= promotion.name %></td>
            </tr>
            <tr>
              <td>Type</td>
              <td><%= ActiveSupport::Inflector.humanize promotion.promo_type %></td>
            </tr>
            <tr>
              <td>Code</td>
              <td><%= promotion.promo_code || '-' %></td>
            </tr>
            <tr>
              <td>Source</td>
              <td><%= link_to nil, promotion.source_url, target: "_blank" %></td>
            </tr>
            <tr>
              <td>Hours Valid</td>
              <td><%= promotion.hours_valid.to_s %></td>
            </tr>
          </tbody>
        </table>
      </div>
      <footer>
        <blockquote style="margin-bottom: 0px; margin-top: 8px">
          Additional conditions and restrictions may apply. Please confirm with the provided source before attempting to redeem.
        </blockquote>
      </footer>
    </form>
  </dialog>
</td>
